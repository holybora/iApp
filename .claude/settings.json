{
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm type-check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm check-all)",
      "Bash(pnpm install)",
      "Bash(pnpm expo install *)",
      "Bash(pnpm drizzle-kit generate*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b feature/*)",
      "Bash(git checkout feature/*)",
      "Bash(git push origin feature/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git merge *)",
      "Bash(rm -rf *)",
      "Edit(android/**)",
      "Edit(ios/**)",
      "Write(android/**)",
      "Write(ios/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-main.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-native-dirs.sh"
          }
        ]
      }
    ]
  }
}
